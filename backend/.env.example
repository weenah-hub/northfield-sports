# ==========================================
#   Copy this file to .env and fill it in
#   cp .env.example .env
# ==========================================

# ---------- Database (Neon PostgreSQL) ----------
# Neon dashboard -> Connection Details -> SQLAlchemy -> copy the URI
DATABASE_URL=postgresql://user:password@host/dbname

# ---------- Google OAuth ----------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI must be: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------- Mailgun (order receipts) ----------
# Mailgun -> Sending -> Domain -> API key
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Northfield Sports <orders@yourdomain.com>

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-random-secret-string

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
SHOP_NAME=Northfield Sports
