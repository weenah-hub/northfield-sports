# ==========================================
#   Copy this file to .env and fill it in
#   cp .env.example .env
# ==========================================

# ---------- Database (Supabase or Neon — either works) ----------
#
# SUPABASE (recommended):
#   1. Supabase dashboard -> open your project
#   2. Click the "Connect" button at the TOP of the project page.
#      (It is no longer under Project Settings -- that is the usual reason
#      people cannot find it.)
#   3. IMPORTANT: choose "Session pooler", NOT "Direct connection".
#      Direct connection uses a host like db.<ref>.supabase.co, which is
#      IPv6-only and usually will not connect from a home network. The pooler
#      host works over IPv4. The pooler host cannot be guessed from your
#      region, so copy it from the dialog.
#   4. Copy the whole string and paste below. The app adds
#      ?sslmode=require automatically.
#
#   You also need the DB password: Project Settings -> Database -> Reset
#   database password. Use the password you set there, NOT your login password.
#
# NEON: dashboard -> Connection Details -> SQLAlchemy -> copy the URI
#
DATABASE_URL=postgresql://user:password@host/dbname

# Set to false only if you deliberately want Supabase's direct IPv6 host.
# Leave it as true unless you know you need to change it.
SUPABASE_USE_POOLER=true

# ---------- Google OAuth ----------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI must be: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------- Mailgun (order receipts) ----------
# Mailgun -> Sending -> Domain -> API key
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Northfield Sports <orders@yourdomain.com>

# ---------- Security ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-random-secret-string

# ---------- Frontend ----------
FRONTEND_URL=http://localhost:5173
SHOP_NAME=Northfield Sports
